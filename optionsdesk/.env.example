# Copy to .env (same dir as docker-compose.yml) and fill in. All optional.

# Alpha Vantage premium key for live quotes / realtime options
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_PREMIUM=1

# Desk config
OPTDESK_CAPITAL=100000
OPTDESK_RFR=0.045

# IBKR live trading — keep OPTDESK_LIVE=0 until you mean it.
# Requires IB Gateway/TWS running on the host (host.docker.internal).
OPTDESK_LIVE=0
IBKR_HOST=host.docker.internal
IBKR_PORT=7497
