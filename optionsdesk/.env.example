# Copy to .env (same dir as docker-compose.yml) and fill in. All optional.

# Host ports (change these if 8080 / 8000 are already in use on your machine)
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Absolute path to your raw options data (mounted read-only for the importer).
# Use a full path, not ~   e.g. /Users/michaelfitzpatrick/.meridian-data
MERIDIAN_DATA=/Users/michaelfitzpatrick/.meridian-data

# Alpha Vantage premium key for live quotes / realtime options
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_PREMIUM=1

# Desk config
OPTDESK_CAPITAL=100000
OPTDESK_RFR=0.045

# IBKR live trading — keep OPTDESK_LIVE=0 until you mean it.
# Requires IB Gateway/TWS running on the host (host.docker.internal).
OPTDESK_LIVE=0
IBKR_HOST=host.docker.internal
IBKR_PORT=7497

# AutoPilot tuning (optional). AUTO_RESEARCH_HR controls how often a research
# batch runs — at 6h a full 9-strategy x 112-ticker sweep takes ~6 weeks;
# at 2h it takes ~2 weeks (more CPU, same safety: the kill switch is never
# blocked by research).
AUTO_RESEARCH_HR=2
AUTO_TRADE_MIN=5
AUTO_DAY_LOSS_FRAC=0.03
AUTO_MIN_HOLDOUT=0.30
AUTO_MAX_OPEN=5
